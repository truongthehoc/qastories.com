{
  "name": "qastories",
  "version": "1.0.0",
  "description": "QA Stories - Studio Portfolio & Booking System (Full-Stack Monolith)",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "build:client": "npm --prefix client install && npm --prefix client run build",
    "build": "npm run build:client",
    "setup:db": "node setup-db.js"
  },
  "workspaces": [
    "client"
  ],
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "nodemailer": "^6.9.15",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "nodemon": "^3.1.7"
  }
}
